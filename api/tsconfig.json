{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "types": ["node", "vite/client"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noImplicitAny": false,
    "strict": false
  },
  "include": ["**/*.ts"],
  "exclude": ["**/__tests__/**", "**/*.test.ts"]
}
