VITE_GOOGLE_MAPS_API_KEY=

VITE_CLERK_PUBLISHABLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

CLERK_SECRET_KEY=
CLERK_JWT_KEY=

HOTEL_PROVIDER_API_KEY=
FLIGHT_PROVIDER_API_KEY=
RAIL_PROVIDER_API_KEY=

# ── Server-only (Vercel env, never VITE_) ──────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
CLERK_WEBHOOK_SECRET=

# Subscription reminders (api/reminders.ts, daily Vercel cron at 09:00 IST)
CRON_SECRET=                 # any long random string; Vercel cron sends it as a Bearer token
RESEND_API_KEY=
RESEND_FROM="RenoCred <reminders@your-verified-domain.com>"
APP_URL=https://renocred.com
# Web Push: generate once with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@renocred.com

# Show Google One Tap on sign-in/up (enable Google in the Clerk dashboard first)
VITE_GOOGLE_ONE_TAP=false
