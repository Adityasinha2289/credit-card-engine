{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "rootDir": "..", "skipLibCheck": true, "noEmitOnError": false,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true, "resolveJsonModule": true,
    "strict": false, "noImplicitAny": false, "types": ["node", "vite/client"], "jsx": "react-jsx"
  },
  "include": ["../api/**/*.ts"],
  "exclude": ["../api/**/__tests__/**", "../api/**/*.test.ts"]
}
